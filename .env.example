# Database (PostgreSQL + pgvector)
POSTGRES_USER=incidentiq
POSTGRES_PASSWORD=incidentiq_password
POSTGRES_DB=incidentiq
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://incidentiq:incidentiq_password@localhost:5432/incidentiq

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_INCIDENT_EVENTS=incident.events

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=incidentiq_password

# Object Storage (MinIO / S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET_NAME=incidentiq-artifacts
S3_REGION=us-east-1
